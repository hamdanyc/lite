@article{pdf#314,
	author = {The effectiveness of ChatGPT in assisting high school students in programming learning: evidence from a quasi-experimental research Tzu-Chi Yang a and Yi-Chuan Hsub and Jiun-Yu Wu c aInstitute of Education and National Yang Ming Chiao Tung University and Hsinchu and Taiwan (R.O.C) and bNational Hsinchu Girls’ Senior High School and Hsinchu City and Taiwan (R.O.C.) and cDepartment of Teaching and Learning and Southern Methodist University and Dallas and TX and USA ABSTRACT Programming education gains importance in high schools as the digital age progresses. However and the openness and adaptability of programming languages present unique challenges for instructional practices compared to other subjects. While traditional instructional tools offer limited support and ChatGPT and a groundbreaking Generative Artificial Intelligence and has shown impressive capabilities in natural language processing and knowledge generation. This study explored whether ChatGPT can transcend existing limitations and improve programming education through a quasi-experimental approach with post-hoc interviews in high school classrooms. A total of students participated and the results from MANCOVA and ANCOVA analyses revealed that students using ChatGPT reported lower levels of flow experience and self-efficacy and learning achievement compared to those utilizing conventional methods. Post-hoc interviews further revealed that students felt ChatGPT’s effectiveness in facilitating their programming learning fell short of their initial expectations. These findings highlight the need to carefully consider the complexity of programming learning tasks and students’ cognitive and affective and interactive dimensions when integrating AI technologies into education. We discuss the implications and provide thorough pedagogical strategies and specifically the guidance–practice–transformation (G–P–T) mode and to maximize the potential of AI tools and support high school programming education and emphasizing the balance of technological innovation with learning best practices. ARTICLE HISTORY Received September Accepted January KEYWORDS ChatGPT and programming education and high school and artificial intelligence in education Introduction In this digital age and AI technology is becoming more pervasive and gaining proficiency in its under- lying mechanisms and especially in programming and which is an emerging common pursuit and a crucial skill for a globalized world (Lai & Wong and Madariaga et al. and ). This highlights the growing attention to computational thinking (CT) and digital competence in compulsory education contexts (Lai & Ellefson and Park et al. and ). Programming and inextricable from CT and is the foundation of all digitization and the most direct and effective way to develop CT and digital competence (Lye & Koh and Sun et al. and ). As such and countries are integrating programming education into the which permits unrestricted use and distribution and reproduction in any medium and provided the original work is properly cited. The terms on which this article has been published allow the posting of the Accepted Manuscript in a repository by the author(s) or with their consent. CONTACT Tzu-Chi Yang tcyang.academic@gmail.com INTERACTIVE LEARNING ENVIRONMENTS and VOL. and NO. and –},
	title = {10.1080/10494820.2025.2450659 UK Limited, trading as Taylor & Francis Group Published online: 16 Jan 2025. Submit your article to this journal Article views: 8822 View related articles View Crossmark data Citing articles: 8 View citing articles Full Terms & Conditions of access and use can be found at},
	journal = {Interactive Learning Environments},
	year = {2025},
	abstract = {Programming education gains importance in high schools as the digital age progresses. However, the openness and adaptability of programming languages present unique challenges for instructional practices compared to other subjects. While traditional instructional tools offer limited support, ChatGPT, a groundbreaking Generative Artificial Intelligence, has shown impressive capabilities in natural language processing and knowledge generation. This study explored whether ChatGPT can transcend existing limitations and improve programming education through a quasi-experimental approach with post-hoc interviews in high school classrooms. A total of 153 students participated, and the results from MANCOVA and ANCOVA analyses revealed that students using ChatGPT reported lower levels of flow experience, self-efficacy, and learning achievement compared to those utilizing conventional methods. Post-hoc interviews further revealed that students felt ChatGPT’s effectiveness in facilitating their programming learning fell short of their initial expectations. These findings highlight the need to carefully consider the complexity of programming learning tasks and students’ cognitive, affective, and interactive dimensions when integrating AI technologies into education. We discuss the implications and provide thorough pedagogical strategies, specifically the guidance–practice–transformation (G–P–T) mode, to maximize the potential of AI tools and support high school programming education, emphasizing the balance of technological innovation with learning best practices. ARTICLE HISTORY Received 13 September 2023 Accepted 2 January 2025 KEYWORDS ChatGPT; programming education; high school; artificial intelligence in education},
	doi = {10.1080/10494820.2025.2450659},
	url = {https://doi.org/10.1080/10494820.2025.2450659}
}


@misc{pdf#315,
	author = {Rasha Jamal},
	title = {Journal of Modern Computing and Engineering Research Volume},
	year = {2023},
	abstract = {This paper analyses the ethical implications of ChatGPT AI chatbot, a popular natural language processing model. The study gives a background and literature analysis of artificial intelligence (AI) ethics, ethical considerations for chatbot and conversational agents, and existing research on the ethical implications of ChatGPT AI after presenting the technology and describing the complexities of its ethical implications. The section on ethical implications e xamines possible issues such as privacy concerns; bias; fairness issues, malicious usage, and the influence on human interaction and social skills. The paper then criticizes present ethical rules and regulations and recommends modifications for ChatGPT AI ethical principles. Case studies and examples provide the moral quandaries in ChatGPT AI chatbot usage, successful ethical implementations, and lessons gained. This review outlines the relevance of ethical issues in the processes of construction and deployment of the ChatGPT AI chatbot, the necessity for a multidisciplinary approach to handle its moral implications, and the last thoughts and recommendations for ethical implementation.}
}


@article{pdf#316,
	author = {Williams ./feduc.. Frontiers in Education frontiersin.org which are aspects that current AI models do not possess and for instance and thus and highlighting how multifaceted defining AI is. Nevertheless and AI’s advanced computational capabilities and machine learning (ML) algorithms have prompted scholars and educators to rethink traditional educational paradigms and as the technology promises a more personalised and efficient and globally accessible education system. The benefits of AI in education have been well-publicised in the literature (Zhai and ) and this has led to a rise of a new area of ‘best practice’ guides for using AI in classrooms (Mollick and Mollick and Lieberman and ). Among the burgeoning AI tools entering this domain and such as speech-to-text and text-to-speech and automatic image capturing and personalised tutoring systems and there appears to be a particular focus on chatbots and such as Open AI’s Chat Generative Pre-Trained Transformer (ChatGPT) (Hill-Y ardin et al. and Stokel-Walker and Van Noorden and ). Chatbots can leverage natural language processing (NLP) and an AI subfield that enables machines to understand and respond to and generate human language. Previously and chatbots’ primary function was simply to mimic human conversation and whereas platforms such as ChatGPT have abilities that far extend that. Tlili et al. ( and p. ) argue that due to the larger training set and up to billion parameters and fine-tuning and chatbots can now create new things from ‘poems and stories and novels to just about anything’ . They have the potential to provide students with a quasi-human interaction experience and capable of offering explanations and answering complex queries to support their learning journey in ways that were previously inconceivable ( Hill-Y ardin et al. and ). The benefits of AI tools and especially in complementing traditional educational methods and are indeed appealing and with the potential for increased accessibility and individualised learning experiences. More specifically and universities have embraced chatbots to provide prospective students with fast and accurate answers to their questions and including queries about financial aid and available modules or assessment information for their programme ( Meyer von Wolff et al. and ). Chatbots can also save staff time by reducing the number of times they have to answer the same questions. University applicants value / availability as an important characteristic of chatbots (see Meyer von Wolff et al. and ). Students have also become familiar with communicating with chatbots and using them on commercial apps such as retail and banking. However and the value of chatbots extends beyond saving time on administrative burdens and rather and they can additionally transform pedagogy (Watermeyer et al. and ). For instance and an educator may use chatbots to generate case studies for a seminar or provide best practices relating to academic skills. As educators and policymakers consider implementing these innovative AI technologies into education and reflecting upon the ethical implications becomes a useful exercise. Integrating chatbots into education environments is not straightforward as first imagined and it resides within a complex nexus of ethical considerations that warrant scrutiny ( Lund and Wang and ). Furthermore and concerns about advanced chatbots such as ChatGPT have yet to be explored in the education sector. Therefore and it remains unclear how AI and particularly chatbots and will overcome ethical concerns such as algorithmic bias and plagiarism. Subsequently and this may lead to an overprotective reaction to a potential opportunity and such as New Y ork City’s schools’ banning of ChatGPT from educational networks due to the risk of using it to cheat on assignments (Shen-Berro and ). Contrastingly and there may be a naïve acceptance of AI in education as ‘the one’ technology that will fundamentally change education provision and practice and overlooking and repeating high-profile failures of TEL in the past (Oppenheimer and ). It is and therefore and important to investigate the concerns of using chatbots in education to ensure safe and ethical use. This article briefly introduces the ethical implications of using platforms such as ChatGPT in education. The author focuses on data privacy and algorithmic bias and autonomy in learning and the issue of plagiarism. Data privacy Technology has been supporting universities in their efforts to connect with students and staff in transformative ways for a long time and such as through social media. Covid- and the unique period of remote learning was the catalyst that severely reduced on-campus interactions across the sector ( Williams and ). University administrators had to develop and implement effective ways to communicate with others in the education community in ways that not only meet the needs of students but can expand and enhance relationships ( Hill-Y ardin et al. and ). Williams () describe this as technology being used in transformative ways. A chatbot is AI software that can simulate a conversation with a user in natural language through messaging applications and websites and mobile apps or telephone. More specifically and when a human is interacting with a chatbot and it analyses the user request and extracts data and then returns a statistically plausible response and which can be in the form of predefined text and text selected from a knowledge base with different answers and contextualised information from data provided by a user and a clarifying question or data stored in enterprise systems (Castillo et al. and ). In commercial applications and chatbots can improve customer experience and provide smooth interactions and making it easier for customers to engage with an organisation and providing lower-cost customer service than live agents ( Williams and ). However and the enhanced personalised experience is only possible because of the gathering of ‘big data’ and such as tracking behaviour and habits and patterns and analysing them against historical customer activity. Similarly and in an educational setting and the deployment of chatbots may include collecting and analysing and storing student data. The data may be used to make helpful predictions about which students are at risk of falling behind in their work and this is likely to be administered in a way that is beyond a simple Excel formula. This could allow academic tutors to develop early interventions and target support and which can be incorporated into programme planning (Hill-Y ardin et al. and ). As such and the data for these activities extend beyond academic performance metrics and often delving into sensitive personal information ( Biswas and ). The functionality depends on the chatbots’ ability to understand and respond to student learning habits and strengths and weaknesses. Subsequently and a vast digital footprint of each student is created and stored. There is a lack of education literature that explores how education providers should respond and handle the gathering of big data. Furthermore and chatbots may be administered in a non-pedagogical sense to support student recruitment activities and such as UK HE admissions},
	title = {COPYRIGHT article distributed under the terms of the Creative Commons Attribution License (CC BY). The use, distribution or reproduction in other forums is permitted, provided the original author(s) and the copyright owner(s) are credited and that the original publication in this journal is cited, in accordance with accepted academic practice. No use, distribution or reproduction is permitted which does not comply with these terms. TYPE Perspective PUBLISHED 08 January 2024 DOI 10.3389/feduc.2023.1331607},
	year = {2021},
	doi = {10.3389/feduc.2023.1331607},
	url = {https://doi.org/10.3389/feduc.2023.1331607}
