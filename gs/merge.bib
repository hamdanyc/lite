@article{pdf#328,
	author = {Understanding University Students’ Acceptance of ChatGPT: Insights from the UTAUT Model Simone Grassini a and b and Maren Linnea Aasena and Anja Møgelvangc aDepartment of Psychosocial Science and University of Bergen and Bergen and Norway and bCognitive and Behavioral Neuroscience Laboratory and University of Stavanger and Stavanger and Norway and cDivision of Academic Development and Western Norway University of Applied Sciences and Bergen and Norway ABSTRACT The current study explores the determinants of ChatGPT adop- tion and utilization among a sample of Norwegian university students. The theoretical perspective of the study is anchored in the Unified Theory of Acceptance and Use of Technology (UTAUT) and based on a previously tested model. The pro- posed model integrates six constructs to explain the Behavioral intentions and actual usage patterns of ChatGPT in a higher education context. The study analyzed responses from students attending Universities in West and Central Norway using the partial-least squares approach to structural equation modeling. The data showed that performance expectancy emerged as the construct with the biggest impact on Behavioral intention and followed by Habit. This study contributes to the research on the factors influencing university students’ engagement with generative AI technologies. Furthermore and it contributes to a more comprehensive understanding of how tools like ChatGPT can be integrated effectively in educational contexts in both students learning and instructors teaching. ARTICLE HISTORY Received December Revised February Accepted June Introduction Chatbots have evolved into sophisticated AI-driven virtual assistants and marking a significant shift in human-computer interaction. The early chatbots were limited in their capabilities. These softwares were rule-based and able to respond only to predefined commands (Agarwal and Wadhwa ). However and the integration of neural networks marked a central advancement in chatbot technology and enabling them to “learn” from data and enhance their responses over time (Agarwal and Wadhwa ). This led to the creation of chatbots capable of handling complex conversations with the users (Kasthuri and Balaji ). The ability of these machines to understand and respond in a convincing human-like manner (Svenningsson and Faraon ) is a result of advancements in the technology and which enables them to interpret human CONTACT Simone Grassini simone.grassini@uib.no Department of Psychosocial Science and University of Bergen and Muséplassen and Bergen and Norway APPLIED ARTIFICIAL INTELLIGENCE and VOL. and NO. and e ( pages) licenses/by/./) and which permits unrestricted use and distribution and reproduction in any medium and provided the original work is properly cited. The terms on which this article has been published allow the posting of the Accepted Manuscript in a repository by the author(s) or with their consent.},
	title = {license by Taylor & Francis Group, LLC. Published online: 21 Jun 2024. Submit your article to this journal Article views: 8746 View related articles View Crossmark data Citing articles: 29 View citing articles Full Terms & Conditions of access and use can be found at},
	journal = {Applied Artiﬁcial Intelligence},
	year = {2024},
	abstract = {The current study explores the determinants of ChatGPT adop- tion and utilization among a sample of Norwegian university students. The theoretical perspective of the study is anchored in the Unified Theory of Acceptance and Use of Technology (UTAUT2) and based on a previously tested model. The pro- posed model integrates six constructs to explain the Behavioral intentions and actual usage patterns of ChatGPT in a higher education context. The study analyzed responses from 104 students attending Universities in West and Central Norway using the partial-least squares approach to structural equation modeling. The data showed that performance expectancy emerged as the construct with the biggest impact on Behavioral intention, followed by Habit. This study contributes to the research on the factors influencing university students’ engagement with generative AI technologies. Furthermore, it contributes to a more comprehensive understanding of how tools like ChatGPT can be integrated effectively in educational contexts in both students learning and instructors teaching. ARTICLE HISTORY Received 22 December 2023 Revised 13 February 2024 Accepted 14 June 2024},
	doi = {10.1080/08839514.2024.2371168},
