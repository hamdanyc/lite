@article{pdf#193,
	author = {A Systematic Review of ChatGPT for English as a Foreign Language Writing: Opportunities and Challenges and Recommendations Article International Journal of TESOL Studies ( 2024},
	title = {A Systematic Review of ChatGPT for English as a Foreign Language Writing: Opportunities, Challenges, and Recommendations Article International Journal of TESOL Studies (},
	journal = {A Systematic Review of ChatGPT for English as a Foreign Language},
	year = {2024},
	abstract = {Since its release in November 2022, ChatGPT has become a focal point of discussion among scholars and practitioners. This study investigates the role of ChatGPT in English as a Foreign Language (EFL) writing through a systematic review of the 20 most pertinent articles. Inclusion and exclusion of references were based on the Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) guidelines. Findings suggest that the integration of artificial intelligence (AI) into education is an evolving process that significantly impacts how EFL students learn to write. This systematic review highlights both the opportunities and challenges associated with adopting ChatGPT for EFL writing. On one hand, ChatGPT offers innovative ways to enhance writing skills, providing instant feedback and diverse writing prompts. On the other hand, challenges such as dependency on AI and the need for critical thinking skills remain. Based on the synthesized literature, recommendations for EFL teaching were proposed, emphasizing a balanced approach to integrating AI tools like ChatGPT into writing curricula and creating a community of practice among teachers and students. Keywords Artificial intelligence, writing instruction, learning to write, teaching writing, digital education Received: 1 June, 2024/Accepted: 27 June, 2024/Published: 1 July, 2024 1. Introduction As AI technology advances, we can expect AI tools to become even more sophisticated, assisting writers in generating unique content, improving language fluency, and adapting to individual writing styles. Ultimately, AI tools have the power to revolutionize writing, making it more efficient, accurate, and accessible for all (AIContentfy Team, 2023) The above quote effectively communicates the supportive role of AI in writing. It highlights that AI is meant to assist and improve the writing process. This perspective is important as it addresses potential concerns about AI taking over educational roles and emphasizes the collaborative relationship between technology and educators. The integration of ChatGPT into academia has become a highly debated topic 37 Mark Feng Teng Wright, et al. in the writing domain, particularly due to its notable features that enhance academic writing in foreign languages (Barrot, 2023). This article aims to explore the potential uses of ChatGPT in EFL writing and the future of teaching writing skills for foreign language learners, with a focus on a collaborative relationship between technology and educators. ChatGPT transforms the education sector. Since its launch in November 2022, ChatGPT developed by OpenAI has achieved remarkable success. By January 2023, it became one of the fastest-growing and most widely accepted artificial intelligence (AI) tools, amassing over 100 million active users within just two months. The underlying technology, Generative Pretrained Transformer (GPT), has revolutionized traditional learning and writing practices. ChatGPT, an open-access and sophisticated chatbot powered by GPT technology, has significantly transformed language teaching and learning (Kohnke et al., 2023). The latest version, ChatGPT-4o, has further advanced these capabilities. ChatGPT processes language and functions as a personal conversational interface, which warrants an examination of how it can support instruction and enhance students’ AI literacy skills. AI literacy, which requires new conceptualization, can be interpreted as the competencies needed to interact effectively with both humans and machines, including the knowledge and skills that enable humans to critically understand, evaluate, and use AI systems and tools to safely and ethically participate in an increasingly digital world ( Long & Magerko, 2020). In this new educational landscape, students must continually strengthen their digital skills to keep pace with rapid technological advancements and prepare for an unpredictable future. AI tools in 21st-century learning environments will equip students to critically analyze AI-generated outputs and become technologically literate in an increasingly tech- centric world. AI can thus enhance professional development by offering real-time feedback and data- driven insights, empowering educators to continually improve their pedagogical practices in teaching writing in a foreign language. Familiarizing students with AI tools like ChatGPT has significant real-world relevance beyond the classroom. ChatGPT has the potential to transform the preparation of writing teachers, enabling them to effectively address the evolving needs of 21st-century learners in building digital literacy and writing skills in a target foreign language with limited language input. However, integrating ChatGPT into writing instruction presents challenges, particularly regarding robust data privacy. The collection and analysis of data by AI tools, including ChatGPT, pose risks, and over-reliance on technology may also diminish the importance of human interaction and mentorship in learning to write (Barrot, 2023). Additionally, the digital divide and unequal access to technology can exacerbate educational disparities (Akgun & Greenhow, 2022). Celik et al. (2022) conducted a comprehensive analysis to investigate the potential and challenges of AI in teaching practices from the perspectives of teachers and their roles in AI-based education research. Their findings highlighted AI’s potential to enhance teaching planning, implementation, and assessment while also emphasizing challenges related to technical capacity, reliability, and the necessity for teacher involvement in AI development. In the context of English language teaching, Kostka and Toncelli (2023) explored the opportunities, such as the accelerated innovation in English teaching due to the emergence of ChatGPT, the challenges, including concerns over potential student misuse for academic work, and recommendations like fostering greater collaboration among teachers, staff, and stakeholders, associated with AI integration. While ChatGPT offers ample opportunities for innovation, widespread concerns about its use in educational settings persist, particularly regarding academic integrity (Teng, 2023). The present study aims to contribute to the role of ChatGPT in teaching and learning English writing by presenting a comprehensive overview of opportunities, challenges, and recommendations. It will also examine gaps and unexplored areas, such as the adaptation of ChatGPT as a writing assistant for learners and teachers, assessment scenarios, pedagogical roles, and ethical considerations. This article aims to provide an overview of the current state of scholarship in teaching EFL writing with ChatGPT. It highlights opportunities, challenges, and recommendations of using ChatGPT for teaching writing, contributing to the ongoing discourse on AI in foreign language writing instruction.}
}


@article{pdf#194,
	author = {et al. and ).The European Union and Spain in particular have been concerned with their dropout rates and have ordered studies into this state of affairs (Commission and Directorate-General for Education and & Culture and Mellizo-Soto and ) Although previous studies suggest that this is preva- lent across different universities and areas of study (Shen et al. and ) and with sociocultural factors and student identification with the course and difficulty of the course and low motivation and self-regulation being some of the main causes of dropping out signaled by the EU (Commission et al. and ) and especially in first-year dropouts. However and areas related to STEMs may have an increased dropout rate due to the initial barrier of technical subjects or lower levels of engagement (Reyes-de Cózar et al. and ). Consequently and in this study and our focus is on Social Sciences & Humanities subjects and courses. Furthermore and another problem that worries university students is the prevalence of negative emotional states such as anxiety or burnout syn- drome and as well as the daunting effect that these factors have on learning retention and therefore on academic performance (Cooper et al. and ). Such a scenario presents the challenge of knowing how to listen to both parties and both educational institutions and their role in the teaching pro- cess and as well as the needs of students in the classroom. On the one hand and we find the demand from new generations of students who are looking for more reactive and stimulating and immediate learning. On the other hand and the position adopted by many institutions regarding the learning meth- odologies implemented has often stalled as traditional. These methodologies and characterized by demanding a passive role from students and where the master class is privileged and tend to receive criticism for not being able to generate engagement and not always reaching good learning outcomes and or not contributing to the satisfaction of students during the teaching process (Bond and ). Faced with this situation and some solutions point to the use of new methodologies in the classroom (Børte et al. and ) and exploring new teaching approaches that and in addition to meeting the demands of the new generations and favor a more active role for the student in the classroom environ- ment (Aidoo et al. and ). These efforts include active learning methodologies and which are postulated as an alternative and capable of achieving greater engagement in university students and increased motivation and as a consequence and an improvement in their academic performance. In addition and their use opens the possibility of taking advantage of technological advances to create new dynamic and innovative opportunities in learning and offering different narratives and discourses better adapted to the needs of the classroom. Among these are methodologies and strategies such as gamification (Ekici and ) or the flipped classroom (Zou et al. and ) and in addition to digital tools such as videos and quizzes and Kahoot! (Wang & Tahir and ) and Socrative (Kocak and ) or Edpuzzle (Hidayat & Praseno and ) and among others. The concept of active learning methodologies has been approached from disciplines as diverse as education and social psychology and or engi- neering and although without reaching a common consensus on its definition (Børte et al. and ). Using a pedagogical approach and according to Hartikainen et al. ( ) and an active learning methodology is any teaching method that involves students in the learning process. This is a clearly holistic approach and under its umbrella we can find many different instructional methodologies and processes and including experiential and collabo- rative and or cooperative learning and as well as case-based and inquiry-based and problem-based and team-based and or game-based learning. Conceptually and active learning is related to constructivism theories and which consider learning as a knowledge construction process in relation to prior knowledge (Driessen et al. and ) and which places understanding before memorization (Mitry and ). Active learning involves a change in the role of stu- dents and going from playing a passive role and as in traditional methodologies and to a clearly active role in the classroom. This also requires students to carry out significant learning activities and think about what they are actually doing and the processes in which they are engaged (Hartikainen et al. and ). Active learning methodologies have been in the spotlight in recent years and like other educational methodologies and they face a mixture of praise and criticism. Although most specialists consider them a good alternative to traditional methodologies and there are those who claim that they may be a temporary educational trend (Hood et al. and ). There are several research works that have highlighted the benefits of active learning methodologies and including those that focus on: how active learning methodologies have been shown to be an effective way of teaching in the field of sciences (Theobald et al. and ) and how they constitute an effective way of improving student engagement (Fisher et al. and ) and they increase stu- dent academic performance (Bressane et al. and ) or enhance motivation in the classroom (Castro and ). Furthermore and other studies state that students develop and improve important skills such as problem solving and peer collaboration and critical thinking and or analytical reasoning (Bean & Melzer and Ting et al. and ). Another important aspect to consider is the positive perception that students have about active learning methodologies. Students show a special interest in the use of active learning methodologies in the classroom (Brown et al. and ) since and in general and they consider that they learn more and better while also helping them develop self-regulatory management habits outside of the classroom and such as autonomy and other social skills (Akiha et al. and ). Even more importantly and they positively valued characteristics such as interactivity or collaboration among equals and as well as the impact on their academic performance (Goode et al. and ). Although active learning methodologies present a promising scenario in the educational field and some caution is still advised. Some research works still stand out as contrary voices for several reasons. First and they argue that there exists a lack of empirical research that measures the effec- tiveness of these pedagogical approaches (Carpenter et al. and ). However and when these methodologies are compared to traditional ones and some studies claim that student engagement does not increase significantly (Deslauriers et al. and ) or that its contribution to lifelong learning is not demonstrated by conclusive evidence (Gu et al. and ). o f CIVIT ET AL .},
	title = {This is an open access article under the terms of the Creative Commons Attribution License, which permits use, distribution and reproduction in any medium, provided the original work is properly cited. Expert Systems. 2024;41:e13703. wileyonlinelibrary.com/journal/exsy 1o f2 4},
	year = {2020},
	abstract = {Background: Active Learning with AI-tutoring in Higher Education tackles dropout rates. Objectives: To investigate teaching-learning methodologies preferred by students. AHP is used to evaluate a ChatGPT-based studented learning methodology which is compared to another active learning methodology and a traditional methodology. Study with Learning Analytics to evaluate alternatives, and help students elect the best strategies according to their preferences. Methods: Comparative study of three learning methodologies in a counterbalanced Single-Group with 33 university students. It follows a pre-test/post-test approach using AHP and SAM. HRV and GSR used for the estimation of emotional states. Findings: Criteria related to in-class experiences valued higher than test-related criteria. Chat-GPT integration was well regarded compared to well-established meth- odologies. Student emotion self-assessment correlated with physiological measures, validating used Learning Analytics. Conclusions: Proposed model AI-Tutoring classroom integration functions effectively at increasing engagement and avoiding false information. AHP with the physiological measuring allows students to determine preferred learning methodologies, avoiding biases, and acknowledging minority groups. KEYWORDS cooperative/collaborative learning, data science applications in education, post-secondary education, teaching/learning strategies 1 | INTRODUCTION 1.1 | Active learning methodologies In recent decades, Higher Education institutions have faced problems such as demotivation, anxiety, or lack of participation in their classrooms. Although the implementation of support programs by educational institutions has tried to alleviate this situation, the dropout rate, which is still around 30% (Ifenthaler & Yau, 2020; Aina et al., 2022) has not decreased in recent years. Researchers claim that among the most important fac- tors that lead students to give up or fail their studies is the low motivation with which they find themselves during the academic process (Pascoe Received: 25 January 2024 Revised: 8 June 2024 Accepted: 31 July 2024 DOI: 10.1111/exsy.13703 This is an open access article under the terms of the Creative Commons Attribution License, which permits use, distribution and reproduction in any medium, provided the original work is properly cited. © 2024 The Author(s). Expert Systems published by John Wiley & Sons Ltd. Expert Systems. 2024;41:e13703. wileyonlinelibrary.com/journal/exsy 1o f2 4 https://doi.org/10.1111/exsy.13703 et al., 2020).The European Union, and Spain in particular have been concerned with their dropout rates and have ordered studies into this state of affairs (Commission, Directorate-General for Education, & Culture, 2022; Mellizo-Soto, 2022) Although previous studies suggest that this is preva- lent across different universities and areas of study (Shen et al., 2022), with sociocultural factors, student identification with the course, difficulty of the course, and low motivation and self-regulation being some of the main causes of dropping out signaled by the EU (Commission et al., 2022), especially in first-year dropouts. However, areas related to STEMs may have an increased dropout rate due to the initial barrier of technical subjects or lower levels of engagement (Reyes-de Cózar et al., 2023). Consequently, in this study, our focus is on Social Sciences & Humanities subjects and courses. Furthermore, another problem that worries university students is the prevalence of negative emotional states such as anxiety or burnout syn- drome, as well as the daunting effect that these factors have on learning retention and therefore on academic performance (Cooper et al., 2018). Such a scenario presents the challenge of knowing how to listen to both parties, both educational institutions and their role in the teaching pro- cess, as well as the needs of students in the classroom. On the one hand, we find the demand from new generations of students who are looking for more reactive, stimulating, and immediate learning. On the other hand, the position adopted by many institutions regarding the learning meth- odologies implemented has often stalled as traditional. These methodologies, characterized by demanding a passive role from students and where the master class is privileged, tend to receive criticism for not being able to generate engagement, not always reaching good learning outcomes, or not contributing to the satisfaction of students during the teaching process (Bond, 2020). Faced with this situation, some solutions point to the use of new methodologies in the classroom (Børte et al., 2023), exploring new teaching approaches that, in addition to meeting the demands of the new generations, favor a more active role for the student in the classroom environ- ment (Aidoo et al., 2022). These efforts include active learning methodologies, which are postulated as an alternative, capable of achieving greater engagement in university students, increased motivation, and, as a consequence, an improvement in their academic performance. In addition, their use opens the possibility of taking advantage of technological advances to create new dynamic and innovative opportunities in learning, offering different narratives and discourses better adapted to the needs of the classroom. Among these are methodologies and strategies such as gamification (Ekici, 2021) or the flipped classroom (Zou et al., 2022), in addition to digital tools such as videos, quizzes, and Kahoot! (Wang & Tahir, 2020), Socrative (Kocak, 2022) or Edpuzzle (Hidayat & Praseno, 2021), among others. The concept of active learning methodologies has been approached from disciplines as diverse as education, social psychology, or engi- neering, although without reaching a common consensus on its definition (Børte et al., 2023). Using a pedagogical approach, according to Hartikainen et al. ( 2019), an active learning methodology is any teaching method that involves students in the learning process. This is a clearly holistic approach, and under its umbrella we can find many different instructional methodologies and processes, including experiential, collabo- rative, or cooperative learning, as well as case-based, inquiry-based, problem-based, team-based, or game-based learning. Conceptually, active learning is related to constructivism theories, which consider learning as a knowledge construction process in relation to prior knowledge (Driessen et al., 2020), and which places understanding before memorization (Mitry, 2021). Active learning involves a change in the role of stu- dents, going from playing a passive role, as in traditional methodologies, to a clearly active role in the classroom. This also requires students to carry out significant learning activities and think about what they are actually doing and the processes in which they are engaged (Hartikainen et al., 2019). Active learning methodologies have been in the spotlight in recent years, and, like other educational methodologies, they face a mixture of praise and criticism. Although most specialists consider them a good alternative to traditional methodologies, there are those who claim that they may be a temporary educational trend (Hood et al., 2021). There are several research works that have highlighted the benefits of active learning methodologies, including those that focus on: how active learning methodologies have been shown to be an effective way of teaching in the field of sciences (Theobald et al., 2020), how they constitute an effective way of improving student engagement (Fisher et al., 2021), they increase stu- dent academic performance (Bressane et al., 2021) or enhance motivation in the classroom (Castro, 2019). Furthermore, other studies state that students develop and improve important skills such as problem solving, peer collaboration, critical thinking, or analytical reasoning (Bean & Melzer, 2021; Ting et al., 2019). Another important aspect to consider is the positive perception that students have about active learning methodologies. Students show a special interest in the use of active learning methodologies in the classroom (Brown et al., 2017) since, in general, they consider that they learn more and better while also helping them develop self-regulatory management habits outside of the classroom, such as autonomy and other social skills (Akiha et al., 2018). Even more importantly, they positively valued characteristics such as interactivity or collaboration among equals, as well as the impact on their academic performance (Goode et al., 2022). Although active learning methodologies present a promising scenario in the educational field, some caution is still advised. Some research works still stand out as contrary voices for several reasons. First, they argue that there exists a lack of empirical research that measures the effec- tiveness of these pedagogical approaches (Carpenter et al., 2020). However, when these methodologies are compared to traditional ones, some studies claim that student engagement does not increase significantly (Deslauriers et al., 2019) or that its contribution to lifelong learning is not demonstrated by conclusive evidence (Gu et al., 2022). 2o f2 4 CIVIT ET AL . 14680394, 2024, 12, Downloaded from https://onlinelibrary.wiley.com/doi/10.1111/exsy.13703 by National Institutes Of Health Malaysia, Wiley Online Library on [11/10/2025]. See the Terms and Conditions (https://onlinelibrary.wiley.com/terms-and-conditions) on Wiley Online Library for rules of use; OA articles are governed by the applicable Creative Commons License},
	doi = {10.1111/exsy.13703},
	url = {https://doi.org/10.1111/exsy.13703}
}


@misc{pdf#195,
	author = {alfredo di tore},
	title = {Type of the Paper (Article},
	year = {2023},
	abstract = {The increasing popularity of emerging artificial intelligence (AI) programs, such as 12 ChatGPT, and their implications for student admission, retention, and suc cess, are being 13 addressed on college campuses in the United States and around the globe. In this 14 mixed-methods study, 165 students completed an online survey regarding their awareness of 15 and perceived benefits and risks associated with AI and ChatGPT use o n their college 16 campus. The findings revealed that most of the student respondents (98.2%) were somewhat 17 familiar with AI and (71.5%) with ChatGPT. Students further reported that the capabilities of 18 AI and ChatGPT are not being fully utilized by college instructors, and this may be due in part 19 to the lack of policies governing the use of AI on academic campuses. Finally, students shared 20 several ideas about the benefits and risks associated with using AI and ChatGPT. For i n-21 stance, the ability of AI to person alize learning was identified as a benefit. However, they 22 raised concerns about potential misconduct such as plagiarism that could arise when using 23 tools like ChatGPT. As AI proliferates on college campuses, faculty and administrators 24 should take the initiative to educate themselves and their students on how AI programs o p-25 erate, how AI data is collected and utilized, and how AI can be strategically and ethically 26 leveraged to support the process of teaching and learning. 27}
}


@article{pdf#196,
	author = {new media & society () Keywords Academic self-efficacy and AI literacy and ChatGPT and college education and digital divide and digital equality and digital literacy and generative AI and socioeconomic status and structural equation modeling Chat Generative Pre-Trained Transformer (ChatGPT) and the conversational AI released by OpenAI on November and rapidly accrued over million active users within months after its initial launch (Halaweh and ). In the context of college education and a recent survey showed that % of U.S. college students had used ChatGPT to complete written assignments and % of those reported using it for more than % of their written assignments (Intelligent and ). Some scholars assert that ChatGPT can reduce educa- tional inequality by providing low-cost personalized tutoring services and learning assis- tance (Baidoo-Anu et al. and Cotton et al. and Kasneci et al. and Sallam and ). Others are concerned that a digital divide in this domain may emerge (Fui-Hoon Nah et al. and Mhlanga and ) and as digital innovations often amplify underlying human and institutional forces and reinforcing existing inequalities (Toyama and Van Dijk and ). These inequities may occur in associations of SES with three levels of the digital divide: skills and use and outcomes (Van Dijk and Van Deursen and Van Dijk and ). Further and trust in ChatGPT may influence these relationships. Applying the digital divide frame- work and this study explores how central influences of socioeconomic status and digital and AI literacy are associated with engagement in a wide range of reported ChatGPT uses/ activities and in turn related to two important educational outcomes and academic self-effi- cacy and creativity. ChatGPT controversy in college education The ongoing controversy about ChatGPT focuses on its potential to both support and displace learning in educational settings. On the positive side and ChatGPT can enhance task efficiency (Halaweh and Sallam and ) and encourage student engagement (Cotton et al. and Kasneci et al. and ) and improve writing skills (Halaweh and ) and facilitate information seeking (Arif et al. and ) and supply personalized tutoring (Baidoo-Anu et al. and ). However and others emphasize that ChatGPT is inherently limited in content quality and accuracy and validity (Baidoo-Anu et al. and Sallam and ) and which can mislead stu- dents. In addition and concerns abound regarding its potential for misuse and overreliance (Fui-Hoon Nah et al. and Kasneci et al. and ) and thereby hindering learning outcomes. Thus and a vital question emerges: does existing digital inequality persist in the context of ChatGPT use? Supporters champion ChatGPT because of its low-cost access: those who lack access to educational resources that require memberships (e.g. Coursera and Grammarly) or are unevenly available geographically can receive personalized assis- tance in a cost-efficient way (Baidoo-Anu et al. and Haque et al. and Kasneci et al. and ). The user-friendly interface also makes it easy for students with lower levels of digital literacy to access information that would otherwise require more sophisticated knowledge and skills such as coding.},
	title = {journals.sagepub.com/home/nms College students’ literacy, ChatGPT activities, educational outcomes, and trust from a digital divide perspective Ceciley (Xinyi) Zhang University of California, Santa Barbara, USA Ronald E Rice University of California, Santa Barbara, USA Laurent H Wang University of California, Santa Barbara, USA Abstract This study investigates the association of socioeconomic status (SES) and digital and AI literacy with types of Chat GPT use by college students, with subsequent implications for academic self-efficacy and creativity, conditioned by trust. Analyses of a survey of U.S. college students (N = 947) show that SES has a greater association with AI literacy than with general digital literacy. Two dimensions of Chat GPT activities emerge: academic support and displacement. Structural equation modeling reveals that AI literacy is positively associated with both activity dimensions, while digital literacy is unexpectedly a negative contributor. Further, academic support is strongly linked to positive outcomes whereas academic displacement is negatively associated. Attitudinal trust in Chat GPT moderates the overall relationships. Our findings suggest that conventional digital inequality persists and evolves with generative AI, traditional digital literacy becomes insufficient in the age of AI, and trust in this new and opaque digital technology influences these relationships. Corresponding author: Ceciley (Xinyi) Zhang, Department of Communication, University of California, Santa Barbara, 4005 Social Science & Media Studies, Santa Barbara, CA 93106, USA. Email: x_zhang828@ucsb.edu 1301741 NMS0010.1177/14614448241301741new media & societyZhang et al. research-article2024 Article},
	year = {2024},
	abstract = {This study investigates the association of socioeconomic status (SES) and digital and AI literacy with types of Chat GPT use by college students, with subsequent implications for academic self-efficacy and creativity, conditioned by trust. Analyses of a survey of U.S. college students (N = 947) show that SES has a greater association with AI literacy than with general digital literacy. Two dimensions of Chat GPT activities emerge: academic support and displacement. Structural equation modeling reveals that AI literacy is positively associated with both activity dimensions, while digital literacy is unexpectedly a negative contributor. Further, academic support is strongly linked to positive outcomes whereas academic displacement is negatively associated. Attitudinal trust in Chat GPT moderates the overall relationships. Our findings suggest that conventional digital inequality persists and evolves with generative AI, traditional digital literacy becomes insufficient in the age of AI, and trust in this new and opaque digital technology influences these relationships. Corresponding author: Ceciley (Xinyi) Zhang, Department of Communication, University of California, Santa Barbara, 4005 Social Science & Media Studies, Santa Barbara, CA 93106, USA. Email: x_zhang828@ucsb.edu 1301741 NMS0010.1177/14614448241301741new media & societyZhang et al. research-article2024 Article 2 new media & society 00(0) Keywords Academic self-efficacy, AI literacy, ChatGPT, college education, digital divide, digital equality, digital literacy, generative AI, socioeconomic status, structural equation modeling Chat Generative Pre-Trained Transformer (ChatGPT), the conversational AI released by OpenAI on November 30, 2022, rapidly accrued over 100 million active users within 2 months after its initial launch (Halaweh, 2023). In the context of college education, a recent survey showed that 30% of U.S. college students had used ChatGPT to complete written assignments; 60% of those reported using it for more than 50% of their written assignments (Intelligent, 2023). Some scholars assert that ChatGPT can reduce educa- tional inequality by providing low-cost personalized tutoring services and learning assis- tance (Baidoo-Anu et al., 2023; Cotton et al., 2023; Kasneci et al., 2023; Sallam, 2023). Others are concerned that a digital divide in this domain may emerge (Fui-Hoon Nah et al., 2023; Mhlanga, 2023), as digital innovations often amplify underlying human and institutional forces, reinforcing existing inequalities (Toyama, 2011; Van Dijk, 2020). These inequities may occur in associations of SES with three levels of the digital divide: skills, use, and outcomes (Van Dijk, 2020; Van Deursen and Van Dijk, 2019). Further, trust in ChatGPT may influence these relationships. Applying the digital divide frame- work, this study explores how central influences of socioeconomic status and digital and AI literacy are associated with engagement in a wide range of reported ChatGPT uses/ activities and in turn related to two important educational outcomes, academic self-effi- cacy and creativity. ChatGPT controversy in college education The ongoing controversy about ChatGPT focuses on its potential to both support and displace learning in educational settings. On the positive side, ChatGPT can enhance task efficiency (Halaweh, 2023; Sallam, 2023), encourage student engagement (Cotton et al., 2023; Kasneci et al., 2023), improve writing skills (Halaweh, 2023), facilitate information seeking (Arif et al., 2023), and supply personalized tutoring (Baidoo-Anu et al., 2023). However, others emphasize that ChatGPT is inherently limited in content quality, accuracy, and validity (Baidoo-Anu et al., 2023; Sallam, 2023), which can mislead stu- dents. In addition, concerns abound regarding its potential for misuse and overreliance (Fui-Hoon Nah et al., 2023; Kasneci et al., 2023), thereby hindering learning outcomes. Thus, a vital question emerges: does existing digital inequality persist in the context of ChatGPT use? Supporters champion ChatGPT because of its low-cost access: those who lack access to educational resources that require memberships (e.g. Coursera and Grammarly) or are unevenly available geographically can receive personalized assis- tance in a cost-efficient way (Baidoo-Anu et al., 2023; Haque et al., 2022; Kasneci et al., 2023). The user-friendly interface also makes it easy for students with lower levels of digital literacy to access information that would otherwise require more sophisticated knowledge and skills such as coding.},
	doi = {10.1177/14614448241301741},
	url = {https://doi.org/10.1177/14614448241301741}
}


@article{pdf#197,
	author = {Computer Assisted LAngu Age LeArning Comparing the effects of ChatGPT and automated writing evaluation on students’ writing and ideal L writing self Huawei Shi a and b and Ching Sing Chai a and Sihan Zhou a and Scott Aubrey a adepartment of Curriculum and i nstruction and Faculty of e ducation and the Chinese university of Hong Kong and Hong Kong sAr and China and bschool of Foreign Languages and Yantai university and shandong and China ABSTRACT The affordances of ChatGPT in language learning and teach - ing have gained increasing traction. While studies began to investigate the potential of ChatGPT as a feedback provider and little attention was given to ChatGPT’s potential impact on students’ writing performance and the ideal L writing self vis-à-vis the established automated writing evaluation systems (AWE). To address these gaps and a sequential explanatory mixed methods design was adopted. One hundred and fifty second-year university students from three writing classes in a Chinese public university were recruited and randomly divided into a ChatGPT group and an AWE group and a control group. After an eleven-week intervention and the ANCOVA results showed that while the ChatGPT group scored significantly higher than the AWE group and the control group in post-writing perfor - mance as measured by their writing score and in terms of stu - dents’ ideal L writing self and the ChatGPT group performed significantly lower than the AWE group with a medium effect size. Qualitative analysis of students’ reflection papers revealed students’ (over)reliance on the tool and the accompanying loss of creativity and agency. Pedagogical implications as well as directions for future research are also discussed. Introduction Advances in technology have been transforming language learning and teaching and especially for writing instruction (Barrot and Godwin-Jones and ). The release of ChatGPT in November may further transform writing instruction. ChatGPT is a form of generative artificial intelligence (GenAI) based on large language models. It can interact nat - urally with humans in a human-like manner and it has been assessed to CONTACT Huawei shi shihuawei@.com d epartment of Curriculum and i nstruction and Faculty of education and the Chinese university of Hong Kong and Hong Kong sAr and China this is an open Access article distributed under the terms of the Creative Commons Attribution-nonCommercial-nod erivatives tion in any medium and provided the original work is properly cited and is not altered and transformed and or built upon in any way. the terms on which this article has been published allow the posting of the Accepted m anuscript in a repository by the author(s) or with their consent. ARTICLE HISTORY Received April Accepted January KEYWORDS ChatGPT and automated writing evaluation (AWE) systems and ideal L writing self and feedback},
	title = {10.1080/09588221.2025.2454541 UK Limited, trading as Taylor & Francis Group Published online: 03 Feb 2025. Submit your article to this journal Article views: 9795 View related articles View Crossmark data Citing articles: 6 View citing articles Full Terms & Conditions of access and use can be found at},
	year = {2025},
	abstract = {The affordances of ChatGPT in language learning and teach - ing have gained increasing traction. While studies began to investigate the potential of ChatGPT as a feedback provider, little attention was given to ChatGPT’s potential impact on students’ writing performance and the ideal L2 writing self vis-à-vis the established automated writing evaluation systems (AWE). To address these gaps, a sequential explanatory mixed methods design was adopted. One hundred and fifty second-year university students from three writing classes in a Chinese public university were recruited and randomly divided into a ChatGPT group, an AWE group, and a control group. After an eleven-week intervention, the ANCOVA results showed that while the ChatGPT group scored significantly higher than the AWE group and the control group in post-writing perfor - mance as measured by their writing score, in terms of stu - dents’ ideal L2 writing self, the ChatGPT group performed significantly lower than the AWE group with a medium effect size. Qualitative analysis of students’ reflection papers revealed students’ (over)reliance on the tool and the accompanying loss of creativity and agency. Pedagogical implications as well as directions for future research are also discussed.},
	doi = {10.1080/09588221.2025.2454541},
	url = {https://doi.org/10.1080/09588221.2025.2454541}
}


