@article{pdf#222,
	author = {Tuijin Jishu/Journal of Propulsion Technology ISSN: - Vol. No. () __________________________________________________________________________},
	title = {CITATIONS 49 READS 10,605 3 authors, including: Shakib Sadat Shanto Explainable LLM and Interpretable Technology Ensemble Lab (ELITE Lab) 20 PUBLICATIONS 221 CITATIONS SEE PROFILE Zishan Ahmed American International University-Bangladesh 18 PUBLICATIONS 203 CITATIONS SEE PROFILE All content following this page was uploaded by Shakib Sadat Shanto on 03 February 2024. The user has requested enhancement of the downloaded file.},
	journal = {See discussions, stats, and author profiles for this publication at: https://www.researchgate.net/publication/377931524},
	year = {2024},
	abstract = {- The emergence of large language models like ChatGPT , a Generative AI (GAI) tool has created excitement about their potential to enhance education, but also concerns about overreliance and lack of critical thinking. This study aims to develop and evaluate a conceptual framework named “AI-CRITIQUE” (AI-based Critical Reflection and Insightful Thought Unleashed for Education) for leveraging ChatGPT to promote critical thinking abilities in higher education settings. Our proposed framework provides structured guidance for focused questioning, gathering diverse perspectives, evaluating res ponses, synthesizing insights, and reflective learning to critically analyze and build upon AI output. An empirical study was conducted with 20 undergraduate students, who answered an open-ended question with and without ChatGPT. They utilized the proposed framework when using ChatGPT. Responses were analyzed using Lee ’s model of thinking levels. A survey also assessed student perceptions. When using the framework with ChatGPT, students' average thinking level significantly increased from recall (1.35) to rationalization (2.4). Survey results showed on average students felt AI helped substantially with idea generation (4.0/5.0) and critical analysis (4.2/5.0) compared to independent work. The study provides preliminary evidence that the proposed framework ca n effectively leverage ChatGPT's capabilities to enhance critical thinking. While further research is needed, this offers a promising novel approach for AI integration to augment human abilities and critical thinking.},
	doi = {10.52783/tjjpt.v45.i01.4680},
	url = {https://doi.org/10.52783/tjjpt.v45.i01.4680}
}


@misc{pdf#223,
	author = {Amir Reza Rahimi},
	title = {Uncovering personalized L2 motivation and self-regulation in ChatGPT-assisted language learning: A hybrid PLS-SEM-ANN approach},
	year = {2025},
	abstract = {Currently, chatbots powered by artificial intelligence (AI) have gained considerable attention due to their ability to provide personalized language learning (PLL) for learners. In this regard, recent studies have extensively explored learners’ emotional aspects, such as their attitudes and acceptance of personalized language learning in chatbots. It is, however, unclear what factors might determine their cognitive behaviors in such a personalized language learning environment, particularly their self-regulation. To fill the gap, the researchers collected data from 133 Iranian EFL learners who had personalized language learning through ChatGPT in their language learning institute and answered our questionnaire that tapped on their personalized L2 motivational self-system (PEL2MSS) and their personalized self-regulation (PESRL). The researchers analyzed the empirical data using a hybrid SEM-artificial neural network (SEM-ANN), in contrast to previous literature that primarily relied on structural equation modeling (SEM). The results showed that ChatGPT significantly responded to language learners’ current L2-self and their ought to L2-self to pass their obligation, and metrics to reach their goals resulted in seeking more assistance from ChatGPT and evaluating their language learning progress with it. Moreover, the sign of digital self-authenticity was also discovered by the researchers, where learners dedicated more motivation to learn language with ChatGPT in comparison with their previous language learning envi- ronments, which culminated in having more self-evaluation, goal-setting, and daily academic schedule to learn language with ChatGPT. Additionally, the ANN analysis supported the linear findings of the PLS-SEM by showing that language learners’ current L2-self, digital self-authenticity, and ought to L2-self were the most significant motivational factors affecting their PESRL. Based on these findings, a new conceptual framework for the PLL was developed in the literature, and the research view was shifted from covering language learners’ emotional as- pects to their cognitive aspects in this environment. Thus we recommend that language teachers should avoid seeing ChatGPT as a tool that learners use for cheating; rather, it can be used as a co-teacher outside of the classroom to help students cover their present language learning needs, which might not be covered in the classroom due to the time restriction. 1. Introduction There is no question that artificial intelligence (AI) and large lan- guage models (LLM) have ushered in a new age of opportunities for educational technologies, and computer-assisted language learning (CALL) is no exception. It is a game changer in education, as well as CALL, which is booming its integration of various chatbots and other AI into the classroom syllabus. Embedded chatbots and AI have revolu- tionized language classes by transforming traditional teacher/student- centered methods into ubiquitous personalized ones (Rahimi & Sevilla-Pav´on, 2024) and teaching with technology into solving prob- lems with it (Rahimi, 2023). An increasing body of research has docu- mented the positive effects of chatbots and AI on language learners’ learning performance, particularly in areas such as writing (Mahapatra, 2024), speaking, and listening (Karatas¸ et al., 2024). Despite this, the majority of the literature focuses on the application, affordances, and challenges of chatbot-based education (Al Murshidi et al., 2024; Li et al., 2024) or exploring learners’ emotional appraisal of these technologies and guides their overall intent to use them in the future (Chan & Zhou, 2023; Lo et al., 2024). However, scholars ignored the cognitive and * Corresponding author. E-mail addresses: arera2@alumni.uv.es (A.R. Rahimi), sh.mahshad.60@gmail.com (M. Sheyhkholeslami), a.mahmoudipour@ltr.basu.ac.ir (A. Mahmoudi Pour). Contents lists available at ScienceDirect Computers in Human Behavior Reports journal homepage: www.sciencedirect.com/journal/computers-in-human-behavior-reports https://doi.org/10.1016/j.chbr.2024.100539 Received 19 September 2024; Received in revised form 7 November 2024; Accepted 22 November 2024 Computers in Human Behavior Reports 17 (2025) 100539 2 behavioral parts of learners in personalized-based learning, where they are much more independent in comparison with previous traditional or online learning environments. A recent systematic and integrative literature review of AI and ChatGPT revealed that there is a dearth of research on the applications, pros and cons, and the attitudes of learners towards them. They strongly recommended that future studies should concentrate on the behavioral and cognitive aspects of learners in these environments (Lo et al., 2024; Wang et al., 2024). Despite these efforts, no solid research has been conducted on the behavioral and cognitive aspects of language learners in artificial intelligence language learning. Filling this gap and heeding those recommendations in the age of arti- ficial intelligence in education, which has gained sudden popularity worldwide, is essential because language learners’ behavioral (e.g., self-regulation), cognitive (e.g., attention), and effective (e.g., emotion) domains are interconnected, and interdependent systems significantly impact the process of language learning (Freeborn et al., 2022; Larsen-Freeman & Cameron, 2008; Oxford, 2016). Accordingly, we will shift the focus from exploring learners’ emotional sides to their behavioral and cognitive ones by investigating the interconnections between language learners’ PEL2MSS and PESRL in ChatGPT-assisted language learning (CHALL). Moreover, by addressing this gap, we can establish much more connection between AI and pos- itive psychology, which could lead to the development of practical methods for fostering motivational-regulation-supportive artificial in- telligence language learning. In the past, there has been evidence that learning English is highly motivational and guided by self-directed and regulatory strategies (Zheng et al., 2018). As a result, this study has the potential to extend and expand the literature on self-regulation and language learning motivation in light of advanced technologies, particularly CAHLL. 2. Literature review 2.1. Personalized L2 motivational self-system The importance of motivation in learning a second or foreign lan- guage cannot be overstated. There is a rapidly expanding body of research dedicated to understanding motivation to learn a second or foreign language, and the D¨ornyei (2005; 2009) L2 motivational self- system has gained prominence as a motivational framework among Second Language Acquisition (SLA) researchers. His theory supplanted the Gardner’s socio-educational model (Gardner, 1985), which concentrated on the language learners’ inte- grative motivation, as it was unable to gauge the motivation of language learners in bilingual environments like Canada and in English as a Foreign Language (EFL) contexts, where learners lack direct exposure to the language. Accordingly, D¨ornyei (2009) developed the L2 motiva- tional self-system (L2MSS) theory that includes three dimensions, namely ideal L2-self, referring back to actual-ideal discrepancy, where language learners learn language to reach their personal and academic objectives in the future. The ought to L2-self refers back to language learners’ obligation to possess as a means of meeting expectations and avoiding negative consequences, and L2-learning experience alludes to situated contextual factors such as teachers, curriculum, and peers that shape language learners’ motivation. The L2MSS has gained a tremen- dous deal of prominence since then. The recent synthetic literature re- view covering research on L2 motivation conducted from 2005 to 2014 (Boo et al., 2015), and another covering research conducted from 2010 to 2019 (Mahmoodi & Yousefi, 2022; Yousefi & Mahmoodi, 2022) indicate that the L2MSS is the dominant theoretical framework in SLA. D¨ornyei’s model reframes L2 motivation as a self-system, but he does not elaborate on its function or justify its inclusion as part of one. Dis- parities between present selves and future selves remain difficult to measure (Thorsen et al., 2020), and the concept of the self-system re- mains unclear. In response to these criticisms, SLA scholars have adapted and extended this model. Thorsen et al. (2017), for example, added the factor of current L2-self and validated that there is a discrepancy between current L2-self and language learners’ ideal L2-self in traditional language learning. In tandem with the development, and integration of ICT into language education, several researchers extended, and adapted the L2MSS for online language learning (Zheng et al., 2018) and an online motivational self-system (Rahimi & Cheraghi, 2022). Moreover, Henry (2013) found that language learners in western countries dedicated more effort to digital language learning in com- parison to their traditional language learning, leading Henry and Clif- fordson (2015) to add authenticity as another L2MSS factor and other studies to validate it as a new L2MSS factor, namely digital self-self-authenticity in online language learning (Smith et al., 2020) and Language Massive Open Online Course (LMOOC; Rahimi, 2023). Due to the predictive power of L2MSS in various language learning environ- ments and the emergence of its new factors, such as current L2-self and digital self-authenticity, we operationally define the following con- structs in the context of personalized language learning, which have yet to be explored: • Ideal L2 self (IDL): language learners’ personal goals for learning a language with ChatGPT in order to reach future self-image. • Ought-to L2 self (OUT): Language learners’ attribution to learn language with ChatGPT to pass or avoid negative outcomes, such as failing their English language course. • Current L2 self (CU): Language learners’ self-descriptions and evaluations of their current language competence and abilities to learn language with ChatGPT. • Digital self-authenticity (DSA): Comparison of language learners’ motivation in learning language with ChatGPT with their previous language learning contexts (e.g., traditional and online language learning). 2.2. Personalized self-regulation A vital component of language learning is self-regulation, which enables learners to chart their own course toward communicative suc- cess. Based on Zimmerman’s (2000) apt definition, self-regulation serves as a guide for students, helping them to transfer their mental abilities into linguistic skills, and a dynamic system, which encompasses moti- vation, metacognition, and behavioral control (Oxford, 2017), provi- deing learners with the ability to effectively manage emotion, thoughts, and behaviors (Zimmerman, 2013). In this process, learning is seen as the culmination of the continuous and conscious management of one’s cognitive resources (Zimmerman, 2013). The importance of self-regulation in a traditional learning context is well established. However, the recent expansion of online learning, where students can learn both asynchronously and synchronously, provides them with an alternative learning environment that allows them to be more in charge of their own learning, emphasizing the need for self-regulation in such a context. However, the context-specific behavior of self-regulation led Barnard et al. (2009) to develop the Online Self-regulated Learning Questionnaire (OSLQ) to explore learners’ online self-regulation with six factors, namely goal setting, time management, task strategies, environment structuring, help seeking, and self-evaluation, which was then adapted to online language learning by Zheng et al. (2016), namely online self-regulation (OSEL). Language learners’ self-regulation and its factors have already been explored in collaborative online language learning (Zheng et al., 2018), flipped classroom (Cengiz & Atas¸, 2024), and LMOOC (Rahimi & Cheraghi, 2022). However, OSEL has not been assessed within a personalized AI environment, particularly CHALL, which prompted this study to explore it and operationally defined the following factors based on study context: • Goal setting (GS) involves the planning and prearrangement of language learners’ outcomes for learning English through ChatGPT. A.R. Rahimi et al.},
	journal = {Elsevier}
}


@misc{pdf#224,
	title = {Towards Ethical Artificial Intelligence in Universities: ChatGPT, Culture, and Mental Health Stigmas in Asian Higher Education Post COVID-19},
	year = {2023},
	abstract = {Mental health can be interpreted as a social taboo in Asia, ensuring that students with mental health stigmas (SWMHS) face complex educational journeys that impact their wellbeing. This article provides a conceptual interdisciplinary commentary that illustrates how in Asian higher education (HE) settings, the psychosocial phenomena of face culture, a sociolinguistic blend of high-context power relations, sense -making, and cultural capital, defines human -to-human (HTH) dialogue. It suggests that human-to-computer-interaction (HC I) through artificial intelligence (AI) technologies, such as ChatGPT, could improve university wellbeing strategies in Asia. The article situates AI discussion into the sociolinguistic features of face culture in Thailand and China through an ethnographic postmodernist lens. The article concludes with a modest conceptual model, considering cultural dimensions and student wellbeing in universities, alongside the ethical implications of using AI to improve mental health in post COVID-19 Asian HE. Aim & Scope: Emerging, Experimental and Current Topics Relevant to Technology in Counselor Education, Supervision and Practice},
	author = {MJ Day},
	journal = {digital.sandiego.edu}
}


@misc{pdf#225,
	author = {ORIGINAL ARTICLE Open Access © The Author(s) 2024},
	title = {ORIGINAL ARTICLE Open Access © The Author(s)},
	year = {2024},
	abstract = {Artificial intelligence (AI) has been integrated into higher education (HE), offering numerous benefits and transforming teaching and learning. Since its launch, ChatGPT has become the most popular learning model among Generation Z college students in HE. This study aimed to assess the knowledge, concerns, attitudes, and ethics of using ChatGPT among Generation Z college students in HE in Peru. An online survey was administered to 201 HE students with prior experience using the ChatGPT for academic activities. Two of the six proposed hypotheses were confirmed: Perceived Ethics (B = 0.856) and Student Concerns (B = 0.802). The findings suggest that HE students’ knowledge and positive attitudes toward ChatGPT do not guarantee its effective adoption and use. It is important to investigate how attitudes of optimism, skepticism, or apathy toward AI develop and how these attitudes influence the intention to use technologies such as the ChatGPT in HE settings. The dependence on ChatGPT raises ethical concerns that must be addressed with responsible use programs in HE. No sex or age differences were found in the relationship between the use of ChatGPTs and perceived ethics among HE students. However, further studies with diverse HE samples are needed to determine this relationship. To promote the ethical use of the ChatGPT in HE, institutions must develop comprehensive training programs, guidelines, and policies that address issues such as academic integrity, privacy, and misinformation. These initiatives should aim to educate students and university teachers on the responsible use of ChatGPT and other AI-based tools, fostering a culture of ethical adoption of AI to leverage its benefits and mitigate its potential risks, such as a lack of academic integrity. Keywords ChatGPT, Artificial intelligence, Perceived ethics, College students, Educational technology, Higher education Page 2 of 23 Acosta-Enriquez et al. International Journal for Educational Integrity (2024) 20:10}
}


@misc{pdf#226,
	author = {Shiri Kashi},
	title = {Examining College Students’ Psychological Dynamics in ChatGPT Assisted Programming Shan Li, Lehigh University, shla22@lehigh.edu Guozhu Ding, Guangzhou University, dinggz@gzhu.edu.cn Juan Zheng, Lehigh University, juz322@lehigh.edu Abstract: In this study, we explored differences in students’ psychological dynamics amo ng three programming support groups. The control group completed programming tasks exclusively with error hints provided by the Jupyter platform . The ChatGPT hints group provided students with more comprehensive and detai led explanations when errors occurred, while the ChatGPT enhanced hints group received not only detailed explanations but also code examples. We examined how various psychological factors, including students’ intrinsic goal orientation, extrinsic goal orientation, task value , task anxiety, critical thinking, cognitive engagement, feeling of knowing, and judgment of lea rning, interacted within each group and how these psychological dynamics differed across the three groups. While we found substantial similarities across the three groups, we also observed notable d istinctions, particularly the negative connections between task anxiety and specific variables . This study holds theoretical and methodological importance by employing a complex dynamical system (CDS) perspective to understand the interplay of students’ psychological factors. Introduction The advent of ChatGPT has ignited substantial inter est among researchers in the realm of AI in educati on. A particularly prominent area of focus centers around the utilization of ChatGPT in programming assistance. Yet, it is important to note that research in this domain is still in its early stages, with a noticeable gap in the investigation of how students ’ psychological factors interact within the context o f ChatGPT assisted programming and how these experiences diverge from traditional programm ing parad igms. This study aims to explore the dynamic interplay between students ’ psychological factors in ChatGPT assisted programming. More specifically, we investigate the impact of different levels of suppo rt on students ’ psychological dynamics. The psychological factors of interest include students’ intrinsic goal orientation, extrinsic goal orientat ion, task value, task anxiety, critical thinking, cognitive engagement, feeling of knowing (FOK), and judgment of learning (JOL). These selected variables encompass motivation, emotiona l aspects (anxiety), cognitive skills (critical thi nking), metacognition (FOK and JOL), and engagement, all of which are crucial factors influencing learning and problem- solving in the context of ChatGPT assisted programming. The study’s significance lies in several key areas. First, it contributes to the burgeoning field of AI in education by shedding light on how students ’ psychological dynamics are influenced by AI interve ntions during programming tasks. This insight is essential for ed ucators, curriculum designers, and policymakers see king to optimize AI integration in education. Moreover, we rely on a complex dynamical system (CDS) perspective to understand the intricate relationships among psychological factors (Koopmans,},
	year = {2020},
	abstract = {In this study, we explored differences in students’ psychological dynamics amo ng three programming support groups. The control group completed programming tasks exclusively with error hints provided by the Jupyter platform . The ChatGPT hints group provided students with more comprehensive and detai led explanations when errors occurred, while the ChatGPT enhanced hints group received not only detailed explanations but also code examples. We examined how various psychological factors, including students’ intrinsic goal orientation, extrinsic goal orientation, task value , task anxiety, critical thinking, cognitive engagement, feeling of knowing, and judgment of lea rning, interacted within each group and how these psychological dynamics differed across the three groups. While we found substantial similarities across the three groups, we also observed notable d istinctions, particularly the negative connections between task anxiety and specific variables . This study holds theoretical and methodological importance by employing a complex dynamical system (CDS) perspective to understand the interplay of students’ psychological factors.}
}


@article{pdf#227,
	author = {Br J Educ Technol. and :–. | wileyonlinelibrary.com/journal/bjet Received: April | Accepted: March DOI: ./bjet. ORIGINAL ARTICLE Examining students' attitudes and intentions towards using ChatGPT in higher education Muhammad Zia Ul Haq | Guangming Cao | Rawan Mazen Yousef Abukhait Digital Transformation Research Center and College of Business Administration and Ajman University and Ajman and UAE Correspondence Muhammad Zia Ul Haq and Digital Transformation Research Center and College of Business Administration and Ajman University and Ajman and UAE. Email: ziasm@yahoo.com Funding information Ajman University and Grant/Award Number: RESDRGS- The release of ChatGPT has sparked an immense academic debate regarding its potential advantages and drawbacks for students. Despite its significance and there is a lack of empirical research on students' at - titudes and behavioural intentions towards the utiliza- tion of ChatGPT. To fill this gap and we employed the integrated AI acceptance- avoidance model (IAAAM) and used partial least squares structural equation modelling to test the research model by collecting data from university students in the UAE. Our key findings indicate that factors such as performance ex- pectancy and effort expectancy positively influence students' attitudes towards ChatGPT. Additionally and personal development concerns demonstrate a negative association with attitudes and intentions to use ChatGPT and while perceived threat demonstrates a non- significant negative association with both. The findings of this research contribute to the emerging body of literature on ChatGPT's usage both concep - tually and empirically. It also offers practical insights for future technology developers and emphasizing the significance of adopting a balanced approach that carefully considers both the benefits and potential drawbacks linked to the utilization of ChatGPT. KEYWORDS AI and attitudes and behavioural intentions and ChatGPT and integrated AI acceptance- avoidance model and personal development concerns},
	title = {CITATIONS 2 READS 648 3 authors, including: Guangming Cao Ajman University 68 PUBLICATIONS 3,396 CITATIONS SEE PROFILE Rawan Mazen Abukhait Ajman University 35 PUBLICATIONS 582 CITATIONS SEE PROFILE All content following this page was uploaded by Muhammad Zia Ul Haq on 05 May 2025. The user has requested enhancement of the downloaded file.},
	year = {2025},
	doi = {10.1111/bjet.13582},
	url = {https://doi.org/10.1111/bjet.13582}
}


@misc{pdf#228,
	author = {Perfect Computer},
	title = {P-ISSN 2664-0422 Pakistan Social Sciences Review April-June},
	year = {2024},
	abstract = {University students have used ChatGPT extensively to complete their academic tasks since its release in November 2022. The objective of the paper was to explore university students’ perceptions regarding the role of ChatGPT in enhancing their academic performance and their concerns regarding the ethical and social implications of using ChatGPT in their academic tasks. The research design of the current qualitative study was phenomenology. Data were collected using semi-structured interviews with eight participants selected purposefully from a private-sector university in Lahore. We used NVivo software (version 14) for data analysis. Clarke and Braun’s (2013) guide for thematic analysis was followed to read, review, and identi fy the codes, patterns, and themes. The analysis revealed that the majority of respondents believed that ChatGPT is a very effective tool that offers practical support to them in generating innovative ideas for solving academic problems. Students also showed serious concerns about the lack of clarity and policy guidelines for effectively using ChatGPT in writing their academic tasks. Based on the study findings, we suggest universities should develop and enforce a policy clarifying the limitations and scope of ChatGPT. KEYWORDS Assessment, Artificial Intelligence, ChatGPT, Knowledge, Student’s Perception}
}


