@article{pdf#324,
	author = {JOURNAL OF DIGITAL LEARNING IN TEACHER EDUCATION TPACK in the age of ChatGPT and Generative AI Punya Mishra a and Melissa Warr b and Rezwana Islam a aMary Lou Fulton Teachers College and Arizona State University and Tempe and AZ and USA and bCollege of Health and Education and Social Transformation and New Mexico State University and Las Cruces and NM and USA ABSTRACT The educational impact of Generative AI (GenAI) tec hnologies and such as ChatGPT and has received significant attention. We use the TPACK framework to discuss the types of knowledge teachers require to effectively use GenAI tools. We highlight the qualities of GenAI that mak e it like other digital technologies (they are protean and opaque and unstabl e) as well as qualities that make it revolutionary (namely and they are genera tive and social). We describe how these traits affect specific knowledge domains (TK and TPK and TCK and XK and TPACK) and explore implications for educato rs. Finally and we argue for a more expansive description of Contextual Knowledg e (XK) and going beyond the immediate context to include considerations of how GenAI will change individuals and society and through that and the broader educational context. Introduction Generative AI (GenAI) has taken the world by storm. Over the past year and GenAI (including tools such as ChatGPT and MidJourney and Stable Diffusion and Bard and Dalle-E and Bing Chat) have become part of everyday discourse (Angwin and Cardona et al. and ). There has been much hand-wringing— and some celebration—about the impact these tools w ill have on education (see and for example and Cardona et al. and Heaven and van Rijmenam and Murgia & Staton and ). Educators have been receiving mixed messages and not suprisingly and there is a great deal of uncertainty about what these technologies mean for teacher practice and teacher education and student learning. It is broadly within this context that we situate t his article. Our goal is to develop a better understanding of the nature of GenAI technologies a nd provide guidance to teachers and teacher educators on their productive use for learning. As described in the Technological Pedagogical Content Knowledge (TPACK) framework (Mishra & Koehl er and ) and teachers need specific types of knowledge to use technology creatively and effec tively in their teaching. The TPACK frame - work argues that knowledge for the successful integ ration of technology not only includes knolwedge of specific content and pedagogical approach es or technology but also requires a dynamic amalgam of all three. These knowledge bases exist i n a “creative tension” with each other where changes in one affect the other two. The advent of GenAI presents new challenges to educational systems and poses significant questions about what learning means and what today’s teachers need to know to be successful. Thus and in this articl e we use TPACK as a framework to explore what teachers need to know to best integrate GenAI tools in their teaching. There are two reasons we are centering our discussi on of GenAI and education around TPACK. First and the TPACK framework has been one of t he most generative and foundational ideas in the field of educational technology and having subs tantial impact on research. Research in this area has been supported by a thriving international community of scholars and practitioners from across content areas including and but not limite d to and mathematics and science and social studies and CONTACT Punya Mishra punya.mishra@asu.edu Mary Lou Fulton Teachers College and Arizona State Un iversity and Tempe and AZ and USA. ARTICLE HISTORY Received August Accepted August KEYWORDS TP ACK and generative AI and chatGPT and teacher education and ChatGPT in education and TP ACK and ChatGPT EDITOR’S INVITED PAPER},
	title = {10.1080/21532974.2023.2247480 Published online: 22 Aug 2023. Submit your article to this journal View related articles View Crossmark data},
	year = {2023},
	abstract = {The educational impact of Generative AI (GenAI) tec hnologies, such as ChatGPT, has received significant attention. We use the TPACK framework to discuss the types of knowledge teachers require to effectively use GenAI tools. We highlight the qualities of GenAI that mak e it like other digital technologies (they are protean, opaque, and unstabl e) as well as qualities that make it revolutionary (namely, they are genera tive and social). We describe how these traits affect specific knowledge domains (TK, TPK, TCK, XK, and TPACK) and explore implications for educato rs. Finally, we argue for a more expansive description of Contextual Knowledg e (XK), going beyond the immediate context to include considerations of how GenAI will change individuals, society and, through that, the broader educational context.},
	doi = {10.1080/21532974.2023.2247480},
	url = {https://doi.org/10.1080/21532974.2023.2247480}
}


@misc{pdf#325,
	author = {Sukhpal Singh Gill},
	title = {Transformative effects of ChatGPT on modern education: Emerging Era of AI Chatbots},
	year = {2023},
	abstract = {ChatGPT, an AI-based chatbot, offers coherent and useful replies based on analysis of large volumes of data. In this article, leading academics, scientists, distinguish researchers and engineers discuss the transformative effects of ChatGPT on modern education. This research discusses ChatGPT capabilities and its use in the education sector, identiﬁes potential concerns and challenges. Our preliminary evaluation shows that ChatGPT perform differently in different subject areas including ﬁnance, coding, maths, and general public queries. While ChatGPT has the ability to help educators by creating instructional content, offering suggestions and acting as an online educator to learners by answering questions, transforming education through smartphones and IoT gadgets, and promoting group work, there are clear drawbacks in its use, such as the possibility of producing inaccurate or false data and circumventing duplicate content (plagiarism) detectors where originality is essential. The often reported “hal- lucinations” within GenerativeAI in general, and also relevant for ChatGPT, can render its use of limited bene ﬁt * Corresponding author. School of Electronic Engineering and Computer Science, Queen Mary University of London, London, E1 4NS, UK. E-mail addresses: s.s.gill@qmul.ac.uk (S.S. Gill), mx.xu@siat.ac.cn (M. Xu), patrospanos@gmail.com (P. Patros), whming@tju.edu.cn (H. Wu), rupinderchem@ gmail.com (R. Kaur), kamalpreet.k@cymax.com (K. Kaur), stephanie.fuller@qmul.ac.uk (S. Fuller), manmeet.singh@utexas.edu (M. Singh), priyansh.arora@ microsoft.com (P. Arora), aknp2@cam.ac.uk (A.K. Parlikad), vlado.stankovski@fri.uni-lj.si (V. Stankovski), ajith.abraham@ieee.org (A. Abraham), skg@cse.iitkgp. ac.in (S.K. Ghosh), hanan@csd.uwo.ca (H. Lut ﬁyya), salil.kanhere@unsw.edu.au (S.S. Kanhere), r.bahsoon@cs.bham.ac.uk (R. Bahsoon), ranaof@cardiff.ac.uk (O. Rana), dustdar@dsg.tuwien.ac.at (S. Dustdar), rizos@manchester.ac.uk (R. Sakellariou), steve.uhlig@qmul.